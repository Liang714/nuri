        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "식사를 추가하고, 나만의 세계가 자라나는 모습을 보고, 내 한 주에 맞는 플랜을 받아 보세요. 내 데이터는 내 것이에요."
          }
        }
      }
    },
